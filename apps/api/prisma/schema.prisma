generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Visit {
  id            String      @id @default(cuid())
  inspectorName String
  siteName      String
  notes         String?
  status        VisitStatus @default(OPEN)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  lastError     String?
  assetCode     String?
  evidence      Evidence[]
  report        Report?
}

model Evidence {
  id         String      @id @default(cuid())
  visitId    String
  imageUrl   String
  mimeType   String
  audioUrl   String?
  createdAt  DateTime    @default(now())
  note       String?
  noteSource NoteSource? @default(TEXT)
  visit      Visit       @relation(fields: [visitId], references: [id])
}

model Report {
  id                   String   @id @default(cuid())
  visitId              String   @unique
  summary              String
  severity             Severity
  defects              Json
  recommendation       String
  needsReview          Boolean  @default(false)
  rawModelJson         Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  historicalAssessment Json?
  visit                Visit    @relation(fields: [visitId], references: [id])
}

enum VisitStatus {
  OPEN
  GENERATING
  COMPLETE
  FAILED
}

enum NoteSource {
  TEXT
  VOICE
}

enum Severity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}
